POLYWEB_ENVIRONMENT=development
POLYWEB_LOG_LEVEL=INFO
POLYWEB_HTTP_TIMEOUT_SECONDS=20
POLYWEB_HTTP_CONNECT_TIMEOUT_SECONDS=5
POLYWEB_HTTP_MAX_CONNECTIONS=20
POLYWEB_HTTP_MAX_KEEPALIVE_CONNECTIONS=10
POLYWEB_USER_AGENT=POLYWEB/0.1

# Docker Compose defaults to the polyweb project name, regardless of the folder.
# Set COMPOSE_PROJECT_NAME for a separate stack, or use docker compose -p NAME.

# OpenTelemetry trace persistence. `database` (default) stores provider-call
# spans in the local SQLite `trace_spans` table served by GET /api/v1/traces;
# `none` disables tracing (no-op runtime, no X-Trace-Id header).
POLYWEB_OTEL_PROCESSOR=database
POLYWEB_OTEL_SERVICE_NAME=POLYWEB
# Stored trace content (query text, normalized results, fetched document) is
# local and sensitive: it persists with the SQLite database until deleted.
# OTLP/Langfuse/LangSmith exporters are future work and register in
# POLYWEB.infrastructure.observability.build_span_processors.

# Provider credentials are runtime vault data, not .env configuration. Store a
# key with PUT /api/v1/providers/{id}/secret (or the settings dashboard).
# Never commit real credentials to this file.

# Optional import inputs for scripts/seed_dev.py only. The running app ignores
# these values and reads credentials from the encrypted database vault instead.
# Fill these in the gitignored .env, then run the seed to populate the dev DB.
# POLYWEB_EXA_API_KEY=
# POLYWEB_FIRECRAWL_API_KEY=
# POLYWEB_TAVILY_API_KEY=
# POLYWEB_PARALLEL_API_KEY=
# POLYWEB_YOU_API_KEY=
# POLYWEB_BRAVE_SEARCH_API_KEY=
# POLYWEB_KEENABLE_API_KEY=
# POLYWEB_TINYFISH_API_KEY=
# Brave Answers has no separate runtime adapter; its key is not imported.
# Optional password override for the five disposable dev users (seed only):
# POLYWEB_DEV_PASSWORD=

# Provider configuration registry (optional; valid JSON on a single line).
#
# Override any provider record. Valid provider names are exa, firecrawl, tavily,
# parallel, you, brave, keenable, tinyfish. Each override may set enabled (bool), priority
# (positive integer; lower is preferred), free_tier_estimates (non-negative
# integers or decimal strings keyed by search, fetch, and cost_estimate; floats
# are rejected to keep Decimal conversion exact), and reset_schedule (any
# non-empty label such as daily or monthly). Estimates are local-only and never
# credentials; keys stay in the encrypted vault, never here.
# POLYWEB_PROVIDER_CONFIG_OVERRIDES={"exa": {"priority": 10, "reset_schedule": "monthly"}, "tavily": {"enabled": false}}

# Local account authentication. The signing key is required before any account
# route can authenticate a request; supply at least 32 random bytes and keep the
# real value in the gitignored .env file, never in code or in this example.
POLYWEB_AUTH_JWT_SECRET=
# Access-token lifetime in seconds (default 900) and the absolute refresh-family
# lifetime in seconds (default 604800, or seven days). The refresh lifetime must
# exceed the access lifetime.
POLYWEB_AUTH_JWT_LIFETIME_SECONDS=900
POLYWEB_AUTH_REFRESH_LIFETIME_SECONDS=604800
# Optional absolute issuer and MCP resource URLs for a reverse proxy. Both must
# use http or https; https is required outside loopback development.
# POLYWEB_AUTH_ISSUER_URL=
# POLYWEB_MCP_RESOURCE_URL=
# Exact browser origins allowed to keep the refresh credential in its strict
# cookie (optional). An empty list keeps the programmatic contract: one JSON
# credential pair plus an opaque Bearer refresh credential. Supply a JSON array
# or a comma-separated list of exact origins. No wildcard, path, userinfo, or
# fragment is accepted, and https is required outside loopback development.
# Production origins belong in the gitignored .env file, not in this example.
# POLYWEB_AUTH_BROWSER_ORIGINS=["https://search.example.com"]

# Transport binds. Each worktree sets its own ports in the gitignored .env file;
# no port value belongs in this committed example. The API and MCP launch
# commands read these values and have no numeric fallback, so a missing port is a
# startup error rather than a collision with another worktree.
POLYWEB_API_HOST=127.0.0.1
# POLYWEB_API_PORT=
POLYWEB_MCP_HOST=127.0.0.1
# POLYWEB_MCP_PORT=

# Telemetry database path. Precedence: the process POLYWEB_DB value, an
# explicit --database argument, this file, then POLYWEB.db in the current
# directory.
POLYWEB_DB=POLYWEB.db
# For the reproducible manual-test fixture, use POLYWEB_DB=POLYWEB.dev.db.
# See docs/development-database.md. Stop the backend before deleting a dev DB.

# Stdio MCP access credential. Read from the process environment only: this file
# can never supply it, because a local file must not become an account
# credential. Leave it unset for HTTP transports.
# POLYWEB_MCP_BEARER_TOKEN=

# Landing app (landing/) dev-server port. Defaults to 5274 when unset.
# POLYWEB_LANDING_PORT=5274

# Docs app (polyweb-docs/) dev-server port. Defaults to 5284 when unset.
# POLYWEB_DOCS_PORT=5284
GITEA_BASE_URL=
GITEA_DOWNLOAD_TOKEN=
