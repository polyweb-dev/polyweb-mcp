# Optional API origin. Leave empty to use same-origin Vite proxy routes.
VITE_API_URL=

# Backend origin the dev/preview server proxies /search, /fetch, /stats,
# /dashboard, and /api to. Defaults to http://127.0.0.1:8001 when unset; set it
# for a session-only backend port, e.g. VITE_BACKEND_URL=http://127.0.0.1:8003.
VITE_BACKEND_URL=
