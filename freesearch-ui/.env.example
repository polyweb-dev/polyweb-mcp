# Optional API origin. Leave empty to use same-origin Vite proxy routes.
# Keep this same-origin: the browser transport sends the refresh cookie and the
# X-FreeSearch-Client marker only to the page origin, so an off-origin value is
# rejected before any credential transfer.
VITE_API_URL=

# Backend origin the dev/preview server proxies /search, /fetch, /stats,
# /dashboard, /api, /auth, and /users to. Defaults to http://127.0.0.1:8001 when
# unset; set it for a session-only backend port, e.g.
# VITE_BACKEND_URL=http://127.0.0.1:8003.
VITE_BACKEND_URL=
