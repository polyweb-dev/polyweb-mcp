GCP_PROJECT_ID=""
# Ordered machine@region pairs. All available zones in a region precede the next pair.
# Replace the placeholders with your machine types and regions before use.
GCP_STANDARD_CANDIDATES="<standard-machine-type>@<primary-region>,<standard-machine-type>@<fallback-region>"
GCP_HEAVY_CANDIDATES="<heavy-machine-type>@<primary-region>,<heavy-machine-type>@<fallback-region>"
GCP_IMAGE_FAMILY="woodpecker-ci-worker"
GCP_IMAGE_PROJECT=""
GCP_BOOT_DISK_SIZE="50GB"
IDLE_TIMEOUT_SECONDS="120"
POLL_INTERVAL_SECONDS="5"
# Limits apply to all VMs owned by this autoscaler, including VMs that start.
MAX_WORKERS="4"
MAX_TOTAL_CPUS="64"
WORKER_STARTUP_TIMEOUT_SECONDS="300"
# Keep agent secrets and API tokens in the existing private .env on the VPS.
